@model EmployeePortalDemo.ViewModels.DepartmentViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Create Department";
}

<h2 class="text-2xl font-bold mb-4">Create New Department</h2>

<form asp-action="Create" method="post" class="bg-white p-6 rounded shadow-md space-y-4">
    <div class="form-group">
        <label asp-for="Department.Name" class="form-label">Department Name</label>
        <input asp-for="Department.Name" class="form-control" />
        <span asp-validation-for="Department.Name" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save Changes</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
