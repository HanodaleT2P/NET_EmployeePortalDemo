@model EmployeePortalDemo.ViewModels.DepartmentFormViewModel

@{
    ViewData["Title"] = "Department Details";
    Layout = "~/Views/Shared/_Layout.cshtml"; // or null if standalone
}



<div class="container mt-5">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center rounded-top-4">
            <h4 class="mb-0">Department</h4>
            <a asp-action="Index" asp-controller="Department" class="btn btn-outline-light btn-sm">
                <i class="bi bi-arrow-left-circle"></i> Back to List
            </a>
        </div>

        <div class="card-body">
            <!-- Tab Navigation -->
            <ul class="nav nav-tabs mb-3" id="departmentTab" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="details-tab" data-bs-toggle="tab" data-bs-target="#details-tab-pane" type="button" role="tab">
                        Department Info
                    </button>
                </li>
               
            </ul>

            <!-- Tab Content -->
            <div class="tab-content" id="departmentTabContent">
                <!-- Department Info Tab -->
                <div class="tab-pane fade show active" id="details-tab-pane" role="tabpanel">
                    <form asp-action="Edit" asp-controller="Department" method="post">
                        <input type="hidden" asp-for="DepartmentId" />
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-bold">Department Name</label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                        <div class="text-end">
                            <button type="submit" class="btn btn-success">Update Changes</button>
                          
                        </div>
                    </form>
                </div>

             
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
}
