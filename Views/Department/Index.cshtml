@model IEnumerable<EmployeePortalDemo.ViewModels.DepartmentViewModel>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    @@keyframes slide-down {
        0%

    {
        opacity: 0;
        transform: translateY(-10px);
    }

    100% {
        opacity: 1;
        transform: translateY(0);
    }

    }

    .animate-slide-down {
        animation: slide-down 0.3s ease-out;
    }
</style>


@if (TempData["SuccessMessage"] != null)
{
    <div id="successAlert" class="fixed top-5 right-5 bg-green-100 border border-green-400 text-green-800 px-6 py-4 rounded shadow-md z-50 animate-slide-down">
        <div class="flex items-center justify-between">
            <span>@TempData["SuccessMessage"]</span>
            <button type="button" class="ml-4 text-green-800 hover:text-green-900 font-bold" onclick="document.getElementById('successAlert').remove();">
                &times;
            </button>
        </div>
    </div>

    <script>
        setTimeout(function () {
            const alert = document.getElementById('successAlert');
            if (alert) alert.remove();
        }, 3000); // auto-remove after 3 seconds
    </script>
}




<div class="flex justify-between items-center mb-6">
    <h2 class="text-2xl font-bold text-gray-800">Department List</h2>
    <a asp-action="Create" class="inline-block px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded shadow">
        ➕ Create New Department
    </a>
</div>

<div class="overflow-x-auto bg-white shadow-md rounded-lg">
    <table class="min-w-full table-auto text-sm text-left text-gray-700">
        <thead class="bg-gray-100 text-gray-700 uppercase text-xs">
            <tr>
                <th class="px-4 py-3">ID</th>
                <th class="px-4 py-3">Department Name</th>
               
                <th class="px-4 py-3 text-center">Actions</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
            @foreach (var dept in Model)
            {
                <tr class="hover:bg-gray-50">
                    <td class="px-4 py-2">@dept.Department.DepartmentId</td>
                    <td class="px-4 py-2">@dept.Department.Name</td>

                    <td class="px-4 py-2 text-center space-x-2">
                        <a asp-action="View"
                           asp-route-id="@dept.Department.DepartmentId"
                           class="inline-block px-3 py-1 bg-green-500 hover:bg-green-600 text-white rounded text-sm font-medium">
                            👁 View
                        </a>
                        <a asp-action="Edit"
                           asp-route-id="@dept.Department.DepartmentId"
                           class="inline-block px-3 py-1 bg-yellow-400 hover:bg-yellow-500 text-white rounded text-sm font-medium">
                            ✎ Edit
                        </a>
                    </td>

                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Hidden Delete Form -->

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const deleteButtons = document.querySelectorAll(".delete-btn");
            const deleteForm = document.getElementById("deleteForm");
            const deleteInput = document.getElementById("deleteDepartmentId");
            const confirmDeleteBtn = document.getElementById("confirmDeleteBtn");

            let selectedId = null;

            deleteButtons.forEach(button => {
                button.addEventListener("click", function () {
                    selectedId = this.getAttribute("data-id");
                    deleteInput.value = selectedId;
                });
            });

            confirmDeleteBtn.addEventListener("click", function () {
                if (selectedId) {
                    deleteForm.submit();
                }
            });
        });
    </script>
}
