@model IEnumerable<EmployeePortalDemo.ViewModels.EmployeeFormViewModel>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="flex justify-between items-center mb-6">
    <h2 class="text-2xl font-bold text-gray-800">Employee List</h2>
    <a asp-action="Create" class="inline-block px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded shadow">
        + Create New Employee
    </a>
</div>


<div class="overflow-x-auto bg-white shadow-md rounded-lg">
    <table class="min-w-full table-auto text-sm text-left text-gray-700">
        <thead class="bg-gray-100 text-gray-700 uppercase text-xs">
            <tr>
                <th class="px-4 py-3">Name</th>
                <th class="px-4 py-3">Email</th>
                <th class="px-4 py-3">Hire Date</th>
                <th class="px-4 py-3">Department</th>
                <th class="px-4 py-3 text-center">Actions</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
            @foreach (var emp in Model)
            {
                <tr class="hover:bg-gray-50">
                    <td class="px-4 py-2">@emp.Name</td>
                    <td class="px-4 py-2">@emp.Email</td>
                    <td class="px-4 py-2">@emp.HireDate.ToShortDateString()</td>
                    <td class="px-4 py-2">@emp.Department</td>
                    <td class="px-4 py-2 text-center">
                        <a asp-action="Edit" asp-route-id="@emp.EmployeeId"
                           class="inline-block px-3 py-1 bg-yellow-400 hover:bg-yellow-500 text-white rounded text-sm font-medium">
                            ✎ Edit
                        </a>
                        <button type="button"
                                class="inline-block px-3 py-1 bg-red-500 hover:bg-red-600 text-white rounded text-sm font-medium delete-btn"
                                data-bs-toggle="modal"
                                data-bs-target="#confirmModal"
                                data-id="@emp.EmployeeId">
                            🗑 Delete
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Hidden Delete Form -->
<form id="deleteForm" method="post" asp-action="Delete">
    <input type="hidden" name="id" id="deleteEmployeeId" />
</form>

<!-- Confirmation Modal -->
<div class="modal fade" id="confirmModal" tabindex="-1" aria-labelledby="confirmModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content rounded-lg shadow-lg">
            <div class="modal-header bg-red-100 text-red-700">
                <h5 class="modal-title font-semibold" id="confirmModalLabel">Confirm Deletion</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-gray-700">
                Are you sure you want to delete this employee?
            </div>
            <div class="modal-footer">
                <button type="button" class="px-4 py-2 bg-gray-300 text-gray-800 rounded hover:bg-gray-400" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="px-4 py-2 bg-red-600 text-white rounded hover:bg-red-700" id="confirmDeleteBtn">Yes, Delete</button>
            </div>
        </div>
    </div>
</div>

<!-- JS to handle delete -->
@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const deleteButtons = document.querySelectorAll(".delete-btn");
            const deleteForm = document.getElementById("deleteForm");
            const deleteInput = document.getElementById("deleteEmployeeId");
            const confirmDeleteBtn = document.getElementById("confirmDeleteBtn");

            let selectedEmpId = null;

            deleteButtons.forEach(button => {
                button.addEventListener("click", function () {
                    selectedEmpId = this.getAttribute("data-id");
                    deleteInput.value = selectedEmpId;
                });
            });

            confirmDeleteBtn.addEventListener("click", function () {
                if (selectedEmpId) {
                    deleteForm.submit();
                }
            });
        });
    </script>
}
