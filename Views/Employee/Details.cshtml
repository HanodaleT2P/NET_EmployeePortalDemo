@model EmployeePortalDemo.Models.Employee

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="max-w-3xl mx-auto mt-6 bg-white shadow-md rounded-lg p-6">
    <div class="flex justify-between items-center mb-4">
        <h2 class="text-2xl font-bold text-gray-800">👤 Employee Details</h2>
        <a asp-action="Index" class="text-blue-600 hover:underline">← Back to List</a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-sm text-gray-700">
        <div class="md:col-span-2">
            <p class="font-semibold mb-2">Photo</p>
            @if (!string.IsNullOrEmpty(Model.PhotoPath))
            {
                <img src="@Url.Content(Model.PhotoPath)" class="rounded-lg shadow-sm max-h-60 border border-gray-300" alt="Employee Photo" />
            }
            else
            {
                <div class="text-gray-500 italic">No photo uploaded</div>
            }
        </div>
        <div>
            <p class="font-semibold">Full Name</p>
            <p class="text-gray-900">@Model.Name</p>
        </div>

        <div>
            <p class="font-semibold">Email</p>
            <p class="text-gray-900">@Model.Email</p>
        </div>

        <div>
            <p class="font-semibold">Hire Date</p>
            <p class="text-gray-900">@Model.HireDate.ToString("yyyy-MM-dd")</p>
        </div>

        <div>
            <p class="font-semibold">Department</p>
            <p class="text-gray-900">@Model.Department?.Name</p>
        </div>

       
    </div>

    
</div>
