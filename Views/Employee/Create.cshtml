
@model EmployeePortalDemo.ViewModels.EmployeeListViewModel

<div class="container mt-5">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header bg-gradient-to-r from-blue-600 to-blue-400 text-white text-center rounded-top-4">
            <h4 id="formTitle" class="mb-0 py-2 fw-bold">@((Model.Employee.EmployeeId > 0) ? "Edit Employee" : "Create Employee")</h4>
        </div>
        <div class="card-body p-4">
            <form id="employeeForm" asp-action="@((Model.Employee.EmployeeId > 0) ? "Edit" : "Create")" asp-controller="Employee" method="post" enctype="multipart/form-data">
                
                <input type="hidden" asp-for="Employee.EmployeeId" />
                <div class="form-group mt-4">
                    <label class="form-label fw-semibold">Upload Photo</label>

                    <div id="uploadBox" class="border border-dashed rounded-3 p-4 text-center position-relative"
                         style="border: 2px dashed #ccc; background-color: #f8f9fa; cursor: pointer;">
                        <input type="file" name="PhotoFile" id="PhotoFile" accept="image/*"
                               class="position-absolute w-100 h-100 top-0 start-0 opacity-0"
                               style="cursor: pointer;" />

                        <div id="uploadPlaceholder">
                            <i class="bi bi-cloud-arrow-up display-4 text-primary"></i>
                            <p class="text-muted mt-2 mb-0">Click or drag & drop a photo here</p>
                        </div>

                        <img id="photoPreview" src="#" alt="Photo Preview"
                             class="img-thumbnail mt-3 d-none"
                             style="max-height: 180px;" />
                    </div>

                    <span class="text-danger small" id="uploadError"></span>

                    @* Show current photo if editing *@
                    @if (Model.Employee.EmployeeId > 0 && !string.IsNullOrEmpty(Model.Employee.PhotoPath))
                    {
                        <div class="mt-3">
                            <label class="form-label fw-semibold">Current Photo</label><br />
                            <img src="@Url.Content(Model.Employee.PhotoPath)" width="150" class="img-thumbnail rounded-3 shadow-sm" />
                        </div>
                    }
                </div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Employee.Name" class="form-label fw-semibold">Full Name</label>
                        <input asp-for="Employee.Name" class="form-control rounded-3" placeholder="Enter employee name" />
                        <span asp-validation-for="Employee.Name" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Employee.Email" class="form-label fw-semibold">Email Address</label>
                        <input asp-for="Employee.Email" type="email" class="form-control rounded-3" placeholder="Enter email" />
                        <span asp-validation-for="Employee.Email" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mt-2">
                    <div class="col-md-6">
                        <label asp-for="Employee.HireDate" class="form-label fw-semibold">Hire Date</label>
                        <input asp-for="Employee.HireDate" type="date" class="form-control rounded-3" />
                        <span asp-validation-for="Employee.HireDate" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Employee.DepartmentId" class="form-label fw-semibold">Department</label>
                        <select asp-for="Employee.DepartmentId" asp-items="Model.Department" class="form-select rounded-3">
                            <option value="">-- Select Department --</option>
                        </select>
                        <span asp-validation-for="Employee.DepartmentId" class="text-danger small"></span>
                    </div>
                </div>
            

                <div class="mt-4 text-center">
                    <button type="submit" id="submitbtn" class="btn btn-success px-5 py-2 me-2 rounded-3 shadow-sm">
                        @((Model.Employee.EmployeeId > 0) ? "Update Employee" : "Save Employee")
                    </button>
                    <a href="/Employee/Index" class="btn btn-outline-secondary px-5 py-2 rounded-3 shadow-sm">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Confirmation Modal -->
<div class="modal fade" id="confirmModal" tabindex="-1" aria-labelledby="confirmModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4">
            <div class="modal-header bg-warning-subtle">
                <h5 class="modal-title text-dark fw-bold" id="confirmModalLabel">Confirm Submission</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center fs-5">
                <p id="confirmMessage">Are you sure you want to proceed?</p>
            </div>
            <div class="modal-footer justify-content-center pb-4">
                <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success px-4" id="confirmSubmit">Yes, Submit</button>
            </div>
        </div>
    </div>
</div>

<!-- Bootstrap & jQuery -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<script>
    $(document).ready(function () {
        let isUpdate = $('#employeeForm input[name="Employee.EmployeeId"]').val() > 0;
        $('#confirmMessage').text(isUpdate ? "Are you sure you want to update this employee?" : "Are you sure you want to save this employee?");

        $('#employeeForm').on('submit', function (e) {
            e.preventDefault();
            $('#confirmModal').modal('show');

            $('#confirmSubmit').off('click').on('click', function () {
                $('#confirmModal').modal('hide');
                document.getElementById('employeeForm').submit();
            });
        });
    });

</script>
<script>
    $(function () {
        const input = $('#PhotoFile');
        const preview = $('#photoPreview');
        const error = $('#uploadError');
        const placeholder = $('#uploadPlaceholder');
        const uploadBox = $('#uploadBox');

        input.on('change', function () {
            const file = this.files[0];
            error.text('');
            preview.addClass('d-none');

            if (file) {
                if (!file.type.startsWith('image/')) {
                    error.text('Please upload an image file.');
                    return;
                }

                if (file.size > 2 * 1024 * 1024) {
                    error.text('File must be less than 2MB.');
                    return;
                }

                const reader = new FileReader();
                reader.onload = function (e) {
                    preview.attr('src', e.target.result).removeClass('d-none');
                    placeholder.hide();
                };
                reader.readAsDataURL(file);
            }
        });

        // Drag over effect
        uploadBox.on('dragover', function (e) {
            e.preventDefault();
            uploadBox.css('border-color', '#007bff');
        });

        uploadBox.on('dragleave drop', function () {
            uploadBox.css('border-color', '#ccc');
        });
    });
</script>

